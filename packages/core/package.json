{
  "name": "@cinema-hall/core",
  "version": "0.2.0",
  "description": "Cinema hall model: YAML/JSON config, validation, seat layout, view metrics, seat manifest and selection rules. Framework-free.",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanja-glinka/cinema-hall-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shanja-glinka/cinema-hall-kit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/shanja-glinka/cinema-hall-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cinema-hall": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cinema",
    "seat-map",
    "booking",
    "hall",
    "yaml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
